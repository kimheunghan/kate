# =====================================================================
#  주간보고 시스템 환경설정
#  이 파일을 .env 로 복사한 뒤 값을 채우세요.
#      cp .env.example .env
#      bash scripts/gen-secrets.sh      # 비밀값 자동 생성
#  ※ .env 는 절대 git 에 커밋하지 마세요.
# =====================================================================

# ---------------------------------------------------------------- APP
# 컨테이너를 호스트에 노출할 포트.
#   개발:  8080  → http://localhost:8080
#   운영:  16000 → http://192.168.200.115:16000
#          외부   http://183.101.26.137:16000
#          도메인 http://aips.iptime.org:16000
# ※ 운영(192.168.200.115)에서 개방된 포트 범위는 16000~16999 입니다.
#    이 범위를 벗어나면 외부에서 접속되지 않습니다.
APP_PORT=16000

# 세션 쿠키 서명 키 (필수, 32바이트 이상 랜덤)
#   openssl rand -hex 32
SESSION_SECRET=

# 세션 유지 시간(초). 기본 12시간
SESSION_TTL_SECONDS=43200

# HTTPS(리버스 프록시 포함)로 서비스하면 true
COOKIE_SECURE=false

# 첨부파일 1개당 최대 크기(MB)
MAX_UPLOAD_MB=50

# 운영 구성에서 증적자료를 보관할 호스트 경로
UPLOAD_HOST_DIR=./data/uploads

# ----------------------------------------------------------------- DB
# 개발(올인원, docker-compose.yml)  : db
# 운영(docker-compose.prod.yml)     : 192.168.200.116
DB_HOST=db
# ※ 운영(192.168.200.116)도 개방 포트가 16000~16999 입니다.
#    PostgreSQL 기본 5432 를 쓸 수 없으므로 16000번대로 노출합니다.
#    (컨테이너 내부는 그대로 5432, 호스트에만 이 포트로 매핑됨)
DB_PORT=16432
DB_NAME=weekly_report
DB_USER=wruser
DB_PASSWORD=

# 개발 구성에서 호스트로 노출할 DB 포트 (psql 접속용, 불필요하면 그대로 두세요)
DB_EXPOSE_PORT=15432

# DB 전용 구성(docker-compose.db.yml)에서 PGDATA 를 둘 호스트 경로
PGDATA_HOST_DIR=./data/pgdata
# DB 를 바인딩할 주소. 특정 대역만 열려면 서버 IP 를 지정하세요.
DB_BIND=0.0.0.0

# -------------------------------------------------------- 초기 관리자
# 관리자 계정이 하나도 없을 때만 자동 생성됩니다.
# 최초 로그인 후 반드시 비밀번호를 변경하세요.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=관리자

# ------------------------------------------------------------- 회원가입
# true  = 가입 즉시 사용 가능 (관리자 승인 불필요)
# false = 관리자 승인 후 사용 가능
SIGNUP_AUTO_APPROVE=true
# 가입 허용 이메일 도메인. 비우면 제한 없음.
#   예) bimatrix.co.kr,partner.co.kr  → 해당 도메인 메일만 가입 가능
SIGNUP_ALLOWED_EMAIL_DOMAINS=

# ------------------------------------------------------------ 메일(SMTP)
# 설정하면 비밀번호 찾기가 "재설정 링크 메일 발송" 방식으로 동작합니다.
# 비워두면 기존처럼 관리자가 임시 비밀번호를 발급하는 방식으로 동작합니다.
SMTP_HOST=
SMTP_PORT=587
# 465 포트(SSL)면 true, 587(STARTTLS)이면 false
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# 보내는 사람 주소 (비우면 SMTP_USER 사용)
SMTP_FROM=
SMTP_FROM_NAME=주간실적 보고 시스템
# 사내 메일서버가 자체서명 인증서를 쓰면 false
SMTP_TLS_REJECT_UNAUTHORIZED=true
# 재설정 링크 유효시간(분)
RESET_TOKEN_MINUTES=30

# 메일에 넣을 링크의 기준 주소 (비우면 접속 주소로 자동 추정)
#   예) http://aips.iptime.org:16000
APP_BASE_URL=http://aips.iptime.org:16000

# SMTP 가 없을 때 비밀번호 찾기 동작
#   direct = 본인 확인(아이디+이름+이메일) 후 즉시 재설정 화면으로 (관리자 개입 없음)
#   admin  = 요청만 접수하고 관리자가 임시 비밀번호 발급
RESET_FALLBACK=direct
# 즉시 재설정 링크 유효시간(분)
RESET_DIRECT_MINUTES=15

# ---------------------------------------------------------------- HTTPS
# 인증서 파일을 지정하면 HTTPS 로 기동합니다.
#   HTTP 로 서비스하면 Chrome 이 파일 다운로드를 '안전하지 않음' 으로 차단합니다.
#   도메인이 없으면 자체 서명 인증서를 만들어 쓰면 됩니다.
#     bash scripts/gen-cert.sh 192.168.200.115 183.101.26.137 aips.iptime.org
SSL_CERT_FILE=
SSL_KEY_FILE=

# 활동 로그 보관 기간(일). 이보다 오래된 기록은 하루에 한 번 지웁니다.
# 0 으로 두면 지우지 않습니다. (기본 365)
AUDIT_RETENTION_DAYS=365
